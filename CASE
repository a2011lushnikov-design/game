/* ============================================================
   EVENTS
   ============================================================ */
document.addEventListener('click', (e)=>{
  const el = e.target.closest('[data-action]');
  if(!el) return;
  const a = el.dataset.action;

  if(a === 'tab'){
    if(currentTab === el.dataset.tab) return;
    document.querySelectorAll('#nav button').forEach(b=> b.classList.toggle('active', b === el));
    currentTab = el.dataset.tab;
    sfx.click();
    render();
    const v = document.getElementById('view'); if(v) v.scrollTop = 0;
  }
  else if(a === 'toggle-sound'){
    state.settings.sound = !state.settings.sound;
    save(); updateHUD();
    if(state.settings.sound) sfx.click();
  }
  else if(a === 'open'){ sfx.click(); openCase(el.dataset.case); }
  else if(a === 'buy'){ sfx.click(); buyCase(el.dataset.case, parseInt(el.dataset.qty,10)); }
  else if(a === 'item'){ sfx.click(); openSheet(el.dataset.key); }
  else if(a === 'sell'){ sellItem(el.dataset.key, parseInt(el.dataset.qty,10)); }
  else if(a === 'craft'){ craftItem(el.dataset.key); }
  else if(a === 'sell-junk'){ sellAllJunk(); }
  else if(a === 'close-sheet'){ closeSheet(); }
  else if(a === 'close-overlay'){
    document.getElementById('overlay').classList.add('hidden');
    isOpening = false;
    render();
  }
  else if(a === 'open-again'){
    const id = el.dataset.case;
    document.getElementById('overlay').classList.add('hidden');
    setTimeout(()=> openCase(id), 60);
  }
  else if(a === 'sell-won'){
    sellItem(el.dataset.key, 1);
    document.getElementById('overlay').classList.add('hidden');
    render();
  }
  else if(a === 'daily'){
    const now = Date.now();
    if(now - state.lastDaily < 24*60*60*1000){ toast('Уже получено'); return; }
    state.lastDaily = now;
    state.coins += 250;
    sfx.coin();
    toast('+250 монет', '#ffd700');
    save(); updateHUD(); render();
  }
  else if(a === 'reset'){
    if(confirm('Сбросить весь прогресс?')){
      SafeStorage.removeItem(SAVE_KEY);
      location.reload();
    }
  }
  else if(a === 'open-promo'){ sfx.click(); openPromo(); }
  else if(a === 'close-promo'){ closePromo(); }
  else if(a === 'submit-promo'){ submitPromo(); }
  else if(a === 'upgrade-luck'){ upgradeLuck(); }
  else if(a === 'open-luck'){
    sfx.click();
    const nextCost = state.luck < LUCK_MAX ? LUCK_COST(state.luck) : null;
    if(state.luck >= LUCK_MAX){ toast('Удача на максимуме'); return; }
    document.getElementById('sheetInner').innerHTML = `
      <div class="sheet-head">
        ${SVG.luck(52)}
        <div>
          <div class="sheet-title" style="color:#c477ff">Удача — уровень ${state.luck}</div>
          <div class="sheet-sub">Бонус: +${state.luck*5}% к шансу редких предметов</div>
        </div>
      </div>
      <div class="luck-bar-wrap"><div class="luck-bar-fill" style="width:${(state.luck/LUCK_MAX)*100}%"></div></div>
      <div style="font-size:12px;color:var(--muted);margin:8px 0 12px;text-align:center">Следующий уровень: <b style="color:#ffd700">${fmt(nextCost)} монет</b></div>
      <button class="btn purple" data-action="upgrade-luck">Прокачать</button>
      <button class="btn" data-action="close-sheet">Отмена</button>
    `;
    document.getElementById('sheet').classList.remove('hidden');
  }
});

document.addEventListener('change', (e)=>{
  if(e.target && e.target.id === 'setSound'){
    state.settings.sound = e.target.checked;
    save(); updateHUD();
  }
});

document.addEventListener('keydown', (e)=>{
  if(e.key === 'Enter' && document.activeElement && document.activeElement.id === 'promoInput'){
    e.preventDefault(); submitPromo();
  }
  if(e.key === 'Escape'){ closeSheet(); closePromo(); }
});

document.getElementById('sheet').addEventListener('click', (e)=>{
  if(e.target.id === 'sheet') closeSheet();
});
document.getElementById('promo').addEventListener('click', (e)=>{
  if(e.target.id === 'promo') closePromo();
});

/* ============================================================
   FREE CASE TIMER
   ============================================================ */
setInterval(()=>{
  if(currentTab !== 'home') return;
  const c = CASES[0];
  const now = Date.now();
  if((state.cases[c.id]||0) > 0) return;
  if((now - state.lastFree) >= c.cd) return;
  const timerEl = document.querySelector('[data-free-timer]');
  if(!timerEl) return;
  const left = Math.ceil((c.cd - (now - state.lastFree))/1000);
  if(left <= 0){ render(); return; }
  const m = Math.floor(left/60), s = left%60;
  timerEl.textContent = `${m}:${String(s).padStart(2,'0')}`;
}, 1000);

/* ============================================================
   INIT
   ============================================================ */
(function init(){
  load();
  if(!SafeStorage.getItem(SAVE_KEY)){
    state.cases = { rusty:1 };
    save();
  }
  buildNav();
  render();
})();

// Глобальный перехват ошибок — покажет сообщение вместо пустого экрана
window.addEventListener('error', (e)=>{
  console.error('Global error:', e.error || e.message);
});
</script>
</body>
