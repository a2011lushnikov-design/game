function toast(msg, color){
  const w = document.getElementById('toast-wrap');
  if(!w) return;
  const el = document.createElement('div');
  el.className = 'toast';
  el.textContent = msg;
  if(color) el.style.borderColor = color;
  w.appendChild(el);
  setTimeout(()=>{ el.style.transition = 'opacity .3s'; el.style.opacity = '0'; setTimeout(()=> el.remove(), 320); }, 2200);
}
function burst(x,y,color,count){
  for(let i=0;i<count;i++){
    const p = document.createElement('div');
    p.className = 'particle';
    p.style.left = x+'px'; p.style.top = y+'px'; p.style.background = color;
    const a = Math.random()*Math.PI*2;
    const d = 50 + Math.random()*180;
    p.style.setProperty('--dx', Math.cos(a)*d+'px');
    p.style.setProperty('--dy', Math.sin(a)*d+'px');
    document.body.appendChild(p);
    setTimeout(()=> p.remove(), 1200);
  }
}
function screenShake(){ document.body.classList.add('shake'); setTimeout(()=> document.body.classList.remove('shake'), 500); }
function screenFlash(color){
  const f = document.createElement('div');
  f.style.cssText = 'position:fixed;inset:0;z-index:400;pointer-events:none;opacity:.9;transition:opacity .6s';
  f.style.background = color;
  document.body.appendChild(f);
  requestAnimationFrame(()=> f.style.opacity = '0');
  setTimeout(()=> f.remove(), 700);
}

