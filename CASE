function openPromo(){
  const p = document.getElementById('promo');
  p.classList.remove('hidden');
  const inp = document.getElementById('promoInput');
  inp.value = '';
  setTimeout(()=> inp.focus(), 100);
}
function closePromo(){ document.getElementById('promo').classList.add('hidden'); }
function submitPromo(){
  const inp = document.getElementById('promoInput');
  const code = (inp.value || '').trim().toUpperCase();
  if(!code){ sfx.error(); return; }
  if(state.usedCodes[code]){ sfx.error(); toast('Код уже использован'); return; }
  const promo = PROMO_CODES[code];
  if(!promo){ sfx.error(); toast('Неверный код'); return; }

  state.usedCodes[code] = Date.now();
  if(promo.type === 'coins') state.coins += promo.amount;
  else if(promo.type === 'case') state.cases[promo.caseId] = (state.cases[promo.caseId]||0) + promo.qty;
  else if(promo.type === 'item'){
    for(let i=0;i<(promo.qty||1);i++) addItemToInv(generateItem(promo.rarity));
  }
  sfx.promo();
  toast(promo.label, '#ffd700');
  burst(window.innerWidth/2, window.innerHeight/2, '#ffd700', 40);
  save(); updateHUD(); render();
  closePromo();
}

