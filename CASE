function chipsFor(weights){
  const total = Object.values(weights).reduce((a,b)=>a+b,0);
  return Object.entries(weights)
    .sort((a,b)=> RARITIES[a[0]].order - RARITIES[b[0]].order)
    .map(([r,w])=>{
      const pct = w/total*100;
      const pctTxt = pct>=10 ? pct.toFixed(0) : pct.toFixed(1);
      return `<span class="chance-chip b-${r}">${RARITIES[r].name} ${pctTxt}%</span>`;
    }).join('');
}

const FAKE_NAMES = ['Kappa','ShadowX','Zed','Mirage','Ghost','Nyx','Vortex','Rift','Echo','Nova','Zero','Pixel','Rogue','Chrome','Vega','Kraken','Onyx','Blaze','Titan','Lynx'];
function makeLiveFeed(){
  const items = [];
  for(let i=0;i<18;i++){
    const rarities = ['trash','common','uncommon','rare','epic','legendary','mythic','godly'];
    const weights = [40,30,15,8,4,2,0.7,0.3];
    const r = weightedSimple(rarities, weights);
    const name = pick(ITEM_POOLS[r]);
    items.push({ name, rarity:r, player: pick(FAKE_NAMES) + rnd(1,99) });
  }
  const html = items.map(it=>{
    return `<span class="live-item">
      <span class="ln">${it.player}</span>
      <span class="lr r-${it.rarity}">${it.name}</span>
    </span>`;
  }).join('');
  return html + html;
}
function weightedSimple(vals, weights){
  const total = weights.reduce((a,b)=>a+b,0);
  let r = Math.random()*total;
  for(let i=0;i<vals.length;i++){ if(r < weights[i]) return vals[i]; r -= weights[i]; }
  return vals[0];
}

function htmlHome(){
  const now = Date.now();
  const cards = CASES.map(c=>{
    const owned = state.cases[c.id] || 0;
    let btn, disabled=false, priceTxt='';
    if(c.free){
      priceTxt = 'Бесплатно';
      if(owned>0) btn = `<button class="case-btn owned" data-action="open" data-case="${c.id}">Открыть ×${owned}</button>`;
      else if((now - state.lastFree) >= c.cd) btn = `<button class="case-btn free" data-action="open" data-case="${c.id}">Открыть бесплатно</button>`;
      else {
        const left = Math.ceil((c.cd - (now - state.lastFree))/1000);
        const m = Math.floor(left/60), s = left%60;
        btn = `<button class="case-btn disabled" data-free-timer>${m}:${String(s).padStart(2,'0')}</button>`;
        disabled = true;
      }
    } else {
      priceTxt = fmt(c.price) + ' монет';
      if(owned>0) btn = `<button class="case-btn owned" data-action="open" data-case="${c.id}">Открыть ×${owned}</button>`;
      else if(state.coins >= c.price) btn = `<button class="case-btn" data-action="open" data-case="${c.id}">Купить и открыть</button>`;
      else { btn = `<button class="case-btn disabled">Не хватает монет</button>`; disabled = true; }
    }
    const firstR = Object.keys(c.weights).sort((a,b)=> RARITIES[a].order - RARITIES[b].order)[0];
    return `
      <div class="case-card ${disabled?'locked':''}" style="border-color:${c.free?'#4caf5055':RARITIES[firstR].color+'33'}">
        ${owned>0?`<div class="case-owned">×${owned}</div>`:''}
        <div class="case-head">${SVG.case[c.iconKey]()}</div>
        <div class="case-name">${c.name}</div>
        <div class="case-price">${priceTxt}</div>
        <div class="case-desc">${c.desc}</div>
        <div class="chances">${chipsFor(c.weights)}</div>
        ${btn}
      </div>`;
  }).join('');
  return `
    <h2>Кейсы</h2>
    <div class="sub">Открой кейс — получи предмет. Чем дороже кейс, тем выше шанс на топ-дроп.</div>
