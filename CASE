/* ============================================================
   ACTIONS
   ============================================================ */
function markCatalog(item){
  const k = itemKey(item);
  if(!state.catalog[k]) state.catalog[k] = 1;
}

function openCase(caseId){
  if(isOpening) return;
  const c = CASES.find(x=>x.id===caseId);
  if(!c) return;
  const owned = state.cases[caseId] || 0;

  if(owned > 0){
    state.cases[caseId] = owned - 1;
    if(state.cases[caseId] <= 0) delete state.cases[caseId];
    if(c.free) state.lastFree = Date.now();
  } else if(c.free){
    const now = Date.now();
    if(now - state.lastFree < c.cd){ sfx.error(); toast('Бесплатный кейс ещё не готов'); return; }
    state.lastFree = now;
  } else {
    if(state.coins < c.price){ sfx.error(); toast('Не хватает монет'); return; }
    state.coins -= c.price;
    state.stats.spent += c.price;
  }
  state.stats.opened += 1;
  save(); updateHUD();

  const rarity = pickRarity(c.weights);
  const item = generateItem(rarity);
  showRoulette(c, item);
}

function buyCase(caseId, qty){
  const c = CASES.find(x=>x.id===caseId);
  if(!c || c.free) return;
  const discount = qty>=50?0.80 : qty>=10?0.88 : qty>=5?0.95 : 1;
  const total = Math.floor(c.price * qty * discount);
  if(state.coins < total){ sfx.error(); toast('Не хватает монет'); return; }
  state.coins -= total;
  state.stats.spent += total;
  state.cases[caseId] = (state.cases[caseId]||0) + qty;
  sfx.buy();
  toast(`Куплено ${qty}× ${c.name}`);
  save(); render();
}

function addItemToInv(item){
  const k = itemKey(item);
  if(state.items[k]) state.items[k].count++;
  else state.items[k] = { ...item, count:1 };
  const ord = RARITIES[item.rarity].order;
  if(ord > state.stats.best) state.stats.best = ord;
  markCatalog(item);
}

function sellItem(key, qty){
  const it = state.items[key];
  if(!it) return;
  qty = Math.min(qty, it.count);
  const gain = it.value * qty;
  state.coins += gain;
  state.stats.earned += gain;
  it.count -= qty;
  if(it.count <= 0) delete state.items[key];
  sfx.coin();
  toast(`+${fmt(gain)} монет`, '#ffd700');
  save(); updateHUD(); closeSheet(); render();
}

function sellAllJunk(){
  let gain = 0, count = 0;
  for(const k of Object.keys(state.items)){
    const it = state.items[k];
    if(it.rarity==='trash' || it.rarity==='common'){
      gain += it.value * it.count;
      count += it.count;
      delete state.items[k];
    }
  }
  if(count === 0){ sfx.error(); return; }
  state.coins += gain;
  state.stats.earned += gain;
  sfx.coin();
  toast(`Продано ${count} шт. за ${fmt(gain)} монет`, '#ffd700');
  save(); updateHUD(); render();
}

function craftItem(key){
  const it = state.items[key];
  if(!it || it.count < 5){ sfx.error(); toast('Нужно 5 одинаковых'); return; }
  const ord = RARITIES[it.rarity].order;
  if(ord >= 7){ sfx.error(); toast('Нельзя скрафтить выше'); return; }
  const nextR = RARITY_KEYS.find(k=>RARITIES[k].order === ord+1);
  it.count -= 5;
  if(it.count <= 0) delete state.items[key];
  const newItem = generateItem(nextR);
  addItemToInv(newItem);
  sfx.craft();
  toast(`Крафт: ${newItem.name} (${RARITIES[nextR].name})`, RARITIES[nextR].color);
  save(); closeSheet(); render();
}

function upgradeLuck(){
  if(state.luck >= LUCK_MAX){ sfx.error(); return; }
  const cost = LUCK_COST(state.luck);
  if(state.coins < cost){ sfx.error(); toast('Не хватает монет'); return; }
  state.coins -= cost;
  state.luck += 1;
  sfx.upgrade();
  toast(`Удача повышена до уровня ${state.luck}`, '#c477ff');
  burst(window.innerWidth/2, window.innerHeight/2, '#c477ff', 30);
  checkAchievements();
  save(); updateHUD(); render();
}

/* ============================================================
   ROULETTE
   ============================================================ */
function showRoulette(container, wonItem){
  isOpening = true;
  const overlay = document.getElementById('overlay');
  const track = document.getElementById('rouTrack');
  const resultSlot = document.getElementById('resultSlot');
  const actions = document.getElementById('overlayActions');
  document.getElementById('overlayTitle').textContent = container.name;

  overlay.classList.remove('hidden');
  resultSlot.innerHTML = '';
  actions.innerHTML = '<button data-action="close-overlay">Закрыть</button>';

  const WIN_INDEX = 52, TOTAL = 60;
  const list = [];
  for(let i=0;i<TOTAL;i++){
    list.push(i === WIN_INDEX ? wonItem : generateItem(pickRarity(container.weights)));
  }
  track.innerHTML = list.map(it=>{
    const R = RARITIES[it.rarity];
    return `<div class="rou-item" style="border-color:${R.color};box-shadow:0 0 12px ${R.color}55">
      <div class="ri-icon">${SVG.item[it.rarity]()}</div>
      <div class="ri-rar r-${it.rarity}">${R.name}</div>
      <div class="ri-name">${it.name}</div>
      <div class="ri-val">${fmt(it.value)}</div>
    </div>`;
  }).join('');

  track.style.transition = 'none';
  track.style.transform = 'translateX(0)';
  void track.offsetWidth;

  const itemW = 110, gap = 8, advance = itemW + gap;
  const wrapW = track.parentElement.clientWidth;
  const targetCenter = WIN_INDEX * advance + itemW/2;
  const targetOffset = targetCenter - wrapW/2;

  const duration = 5200;
  track.style.transition = `transform ${duration}ms cubic-bezier(0.12, 0.85, 0.25, 1)`;
  track.style.transform = `translateX(${-targetOffset}px)`;
  sfx.open();
  scheduleRouletteTicks(duration);

  setTimeout(()=>{
    isOpening = false;
    addItemToInv(wonItem);
    const R = RARITIES[wonItem.rarity];

    resultSlot.innerHTML = `
      <div class="result-card" style="border-color:${R.color};box-shadow:0 0 30px ${R.color}88">
        <div class="rc-icon">${SVG.item[wonItem.rarity]()}</div>
        <div class="rc-name">${wonItem.name}</div>
        <div class="rc-rar r-${wonItem.rarity}">${R.name}</div>
        <div class="rc-val">${fmt(wonItem.value)} монет</div>
      </div>`;

    let canRepeat = false;
    if((state.cases[container.id]||0) > 0) canRepeat = true;
    else if(container.free) canRepeat = (Date.now() - state.lastFree) >= container.cd;
    else canRepeat = state.coins >= container.price;

    actions.innerHTML = `
      <button class="primary" data-action="open-again" data-case="${container.id}" ${canRepeat?'':'disabled style="opacity:.4;pointer-events:none"'}>Открыть ещё</button>
      <button data-action="sell-won" data-key="${itemKey(wonItem)}">Продать за ${fmt(wonItem.value)}</button>
      <button data-action="close-overlay">Закрыть</button>
    `;

    sfx.reveal(wonItem.rarity);
    const cx = window.innerWidth/2, cy = window.innerHeight/2;
    const count = wonItem.rarity==='godly'?70 : wonItem.rarity==='mythic'?50 :
                  wonItem.rarity==='legendary'?38 : wonItem.rarity==='epic'?26 :
                  wonItem.rarity==='rare'?18 : 10;
    burst(cx, cy, R.color, count);
    if(R.order >= 6) screenShake();
    if(wonItem.rarity === 'godly') screenFlash('rgba(255,255,255,.85)');
    if(navigator.vibrate && R.order >= 5) try { navigator.vibrate([40,30,60]); } catch(e){}

    checkAchievements();
    save(); updateHUD();
    if(currentTab==='home') render();
  }, duration + 150);
}

function checkAchievements(){
  let changed = false;
  for(const a of ACHIEVEMENTS){
    if(!state.ach[a.id] && a.check(state)){
      state.ach[a.id] = true;
      toast(`Достижение: ${a.name}`, '#ffd700');
      sfx.ach();
      changed = true;
    }
  }
  if(changed) save();
}

