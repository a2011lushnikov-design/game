function scheduleRouletteTicks(duration){
  if(!state.settings.sound) return;
  let t = 0.15;
  while(t < duration - 0.15){
    const progress = t / duration;
    const freq = 1500 - progress*500;
    const vol = 0.022 * (1 - progress*0.55);
    beep(freq, 0.015, vol, 'square', t);
    const interval = 0.035 + Math.pow(progress, 2.5) * 0.22;
    t += interval;
  }
}

