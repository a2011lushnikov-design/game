const rnd = (a,b)=> Math.floor(Math.random()*(b-a+1))+a;
const pick = arr => arr[Math.floor(Math.random()*arr.length)];
function hashStr(s){ let h=2166136261; for(let i=0;i<s.length;i++){ h^=s.charCodeAt(i); h=Math.imul(h,16777619); } return h>>>0; }
function itemValue(name, rarity){
  const [lo,hi] = RARITIES[rarity].value;
  const h = hashStr(name);
  return lo + (h % (hi - lo + 1));
}
function luckMultiplier(){ return 1 + state.luck * 0.05; }

function pickRarity(baseWeights){
  const weights = {};
  const mult = luckMultiplier();
  for(const [k,w] of Object.entries(baseWeights)){
    const order = RARITIES[k].order;
    weights[k] = order >= 3 ? w * mult : w;
  }
  const total = Object.values(weights).reduce((a,b)=>a+b,0);
  let r = Math.random()*total;
  for(const [k,w] of Object.entries(weights)){
    if(r < w) return k;
    r -= w;
  }
  return Object.keys(weights)[0];
}
function generateItem(rarity){
  const pool = ITEM_POOLS[rarity] || ITEM_POOLS.common;
  const name = pick(pool);
  return { name, rarity, value: itemValue(name, rarity) };
}
