<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Container Rush</title>
<style>
:root{
  --bg:#0a0a12; --bg2:#12121f; --panel:#1a1a2e; --panel2:#22223a;
  --border:#2a2a44; --text:#e8e8f0; --muted:#8a8aa0;
  --accent:#00d4ff; --gold:#ffd700; --nav-h:64px;
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%;overflow:hidden}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:var(--bg);color:var(--text);display:flex;flex-direction:column;overscroll-behavior:none}
button{font-family:inherit;cursor:pointer;border:none;outline:none;background:none;color:inherit}
svg{display:block}

#hud{display:flex;justify-content:space-between;align-items:center;padding:8px 12px;background:linear-gradient(180deg,#16162a,#0a0a12);border-bottom:1px solid var(--border);z-index:10;padding-top:calc(8px + env(safe-area-inset-top));gap:8px}
.hud-l{display:flex;align-items:center;gap:8px;flex-shrink:0}
.hud-r{display:flex;align-items:center;gap:6px;flex-shrink:0}
.avatar{width:36px;height:36px;border-radius:50%;overflow:hidden;flex-shrink:0;box-shadow:0 0 0 2px #2a2a44}
.lvl{font-size:10px;color:var(--muted);line-height:1.15}
.lvl b{color:var(--accent);font-size:13px;font-weight:700}
.coin-box{display:flex;align-items:center;gap:6px;background:linear-gradient(135deg,#2a2a44,#1a1a2e);padding:6px 12px 6px 8px;border-radius:20px;border:1px solid #3a3a5a;flex-shrink:0}
.coin-box svg{width:18px;height:18px;flex-shrink:0}
.coin-val{font-size:15px;font-weight:700;color:var(--gold);font-variant-numeric:tabular-nums}
.hud-center{display:flex;align-items:center;gap:8px;flex:1;justify-content:center}
.luck-pill{display:flex;align-items:center;gap:5px;background:#2a1440;border:1px solid #6a1a9a;padding:4px 10px;border-radius:14px;font-size:11px;font-weight:700;color:#c477ff;cursor:pointer;transition:transform .12s}
.luck-pill:active{transform:scale(.94)}
.icon-btn{width:36px;height:36px;border-radius:10px;background:var(--panel);display:flex;align-items:center;justify-content:center;transition:background .15s,transform .12s;color:#cfcfe0}
.icon-btn:active{background:var(--panel2);transform:scale(.92)}
.icon-btn svg{width:20px;height:20px}

#view{flex:1;overflow-y:auto;padding:14px;padding-bottom:calc(var(--nav-h) + 20px + env(safe-area-inset-bottom));-webkit-overflow-scrolling:touch}
h2{font-size:18px;margin-bottom:6px}
.sub{font-size:12px;color:var(--muted);margin-bottom:12px}

.live-feed{display:flex;align-items:center;gap:8px;background:linear-gradient(90deg,#12121f,#1a1a2e,#12121f);border:1px solid var(--border);border-radius:10px;padding:8px 10px;margin-bottom:12px;overflow:hidden;position:relative;height:38px}
.live-label{font-size:9px;font-weight:800;letter-spacing:.6px;color:#ff4444;flex-shrink:0;display:flex;align-items:center;gap:4px}
.live-label .dot{width:6px;height:6px;border-radius:50%;background:#ff4444;animation:pulse 1.2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}
.live-track{display:flex;gap:20px;animation:scrollFeed 30s linear infinite;white-space:nowrap;flex:1}
@keyframes scrollFeed{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.live-item{display:inline-flex;align-items:center;gap:6px;font-size:11px;color:#cfcfe0;flex-shrink:0}
.live-item .ln{color:var(--muted)}
.live-item .lr{font-weight:800}

.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}
.case-card{background:var(--panel);border-radius:14px;padding:12px;border:1.5px solid var(--border);position:relative;overflow:hidden;transition:transform .15s,border-color .15s,box-shadow .2s;display:flex;flex-direction:column;gap:8px}
.case-card:active{transform:scale(.97)}
.case-card.locked{opacity:.55}
.case-head{display:flex;justify-content:center;align-items:center;padding:6px 0}
.case-head svg{width:58px;height:58px;filter:drop-shadow(0 4px 8px rgba(0,0,0,.4))}
.case-name{font-size:13px;font-weight:700;text-align:center}
.case-price{font-size:13px;color:var(--gold);font-weight:700;text-align:center;font-variant-numeric:tabular-nums}
.case-desc{font-size:10.5px;color:var(--muted);line-height:1.3;min-height:26px;text-align:center}
.case-btn{width:100%;padding:9px 6px;border-radius:9px;background:linear-gradient(135deg,#00d4ff,#0080ff);color:#001;font-size:12px;font-weight:700;letter-spacing:.3px;transition:filter .15s}
.case-btn:active{filter:brightness(.85)}
.case-btn.disabled{background:#333;color:#666;cursor:not-allowed}
.case-btn.free{background:linear-gradient(135deg,#4caf50,#2e7d32);color:#fff}
.case-btn.owned{background:linear-gradient(135deg,#ffb300,#ff6f00);color:#221}
.case-owned{position:absolute;top:8px;right:8px;background:#00d4ff;color:#001;font-size:10px;font-weight:800;padding:2px 7px;border-radius:10px;z-index:1}

.r-trash{color:#6b6b6b} .r-common{color:#dcdcdc} .r-uncommon{color:#4caf50}
.r-rare{color:#2196f3} .r-epic{color:#9c27b0} .r-legendary{color:#ffb300}
.r-mythic{color:#e91e63}
.r-godly{background:linear-gradient(90deg,#ff0000,#ff8800,#ffee00,#00ff88,#00ccff,#8844ff,#ff00aa);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent}
.b-trash{background:#2a2a2a;color:#aaa}
.b-common{background:#333;color:#ddd}
.b-uncommon{background:#1b3d20;color:#6fdd7a}
.b-rare{background:#0d2a4a;color:#5cb8ff}
.b-epic{background:#2d1440;color:#c477ff}
.b-legendary{background:#4a3600;color:#ffd54f}
.b-mythic{background:#4a0d24;color:#ff6b9d}
.b-godly{background:#1a0a2a;color:#fff;background-image:linear-gradient(90deg,#ff0000,#ff8800,#ffee00,#00ff88,#00ccff,#8844ff,#ff00aa)}

.inv-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(88px,1fr));gap:8px}
.inv-item{background:var(--panel);border-radius:10px;padding:8px 6px;text-align:center;position:relative;border:1.5px solid var(--border);transition:transform .12s;cursor:pointer}
.inv-item:active{transform:scale(.95)}
.inv-count{position:absolute;top:4px;right:4px;background:var(--accent);color:#001;font-size:10px;font-weight:800;padding:1px 5px;border-radius:8px}
.inv-rar{font-size:9px;font-weight:700;letter-spacing:.3px}
.inv-icon{display:flex;justify-content:center;margin:3px 0}
.inv-icon svg{width:34px;height:34px}
.inv-name{font-size:10px;line-height:1.15;height:22px;overflow:hidden;color:#cfcfe0}
.inv-val{font-size:10px;color:var(--gold);font-weight:700;margin-top:2px}

.shop-item{background:var(--panel);border-radius:12px;padding:12px;border:1.5px solid var(--border);margin-bottom:10px;display:flex;flex-direction:column;gap:8px}
.shop-head{display:flex;align-items:center;gap:12px}
.shop-icon svg{width:44px;height:44px}
.shop-info{flex:1}
.shop-name{font-size:14px;font-weight:700}
.shop-price{font-size:12px;color:var(--gold);font-weight:700}
.chances{display:flex;flex-wrap:wrap;gap:4px}
.chance-chip{font-size:9.5px;font-weight:700;padding:3px 7px;border-radius:6px;display:inline-flex;align-items:center;gap:3px}
.buy-row{display:flex;gap:6px}
.buy-btn{flex:1;padding:8px 4px;border-radius:8px;background:var(--panel2);color:var(--text);font-size:11px;font-weight:700;transition:background .12s;border:1px solid var(--border)}
.buy-btn:active{background:#33335a}
.buy-btn b{display:block;font-size:12px;color:var(--gold);margin-top:2px}
.buy-btn small{display:block;font-size:9px;color:#4caf50;font-weight:600}

.ach{background:var(--panel);border-radius:10px;padding:12px;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;gap:10px;border-left:3px solid #333}
.ach.done{border-left-color:#4caf50}
.ach-name{font-size:13px;font-weight:700}
.ach-desc{font-size:11px;color:var(--muted);margin-top:2px}
.ach-check{width:24px;height:24px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.ach-check svg{width:22px;height:22px}

.set-group{background:var(--panel);border-radius:12px;padding:14px;margin-bottom:10px}
.set-row{display:flex;justify-content:space-between;align-items:center;padding:8px 0;font-size:13px}
.switch{position:relative;display:inline-block;width:46px;height:26px}
.switch input{opacity:0;width:0;height:0}
.slider{position:absolute;cursor:pointer;top:0;left:0;right:0;bottom:0;background:#333;transition:.25s;border-radius:26px}
.slider:before{position:absolute;content:"";height:20px;width:20px;left:3px;bottom:3px;background:#fff;transition:.25s;border-radius:50%}
.switch input:checked + .slider{background:var(--accent)}
.switch input:checked + .slider:before{transform:translateX(20px)}
.btn{display:block;width:100%;padding:11px;border-radius:10px;background:var(--panel2);color:var(--text);font-size:13px;font-weight:700;margin-top:8px;transition:background .12s,filter .12s;text-align:center}
.btn:active{background:#33335a}
.btn.green{background:linear-gradient(135deg,#4caf50,#2e7d32);color:#fff}
.btn.red{background:linear-gradient(135deg,#e91e63,#b0003a);color:#fff}
.btn.gold{background:linear-gradient(135deg,#ffb300,#ff6f00);color:#221}
.btn.blue{background:linear-gradient(135deg,#00d4ff,#0080ff);color:#001}
.btn.purple{background:linear-gradient(135deg,#9c27b0,#6a1a9a);color:#fff}
.stat-line{display:flex;justify-content:space-between;font-size:12px;padding:5px 0;color:var(--muted)}
.stat-line b{color:var(--text)}

.luck-bar-wrap{height:8px;background:#2a1440;border-radius:6px;overflow:hidden;margin:8px 0}
.luck-bar-fill{height:100%;background:linear-gradient(90deg,#9c27b0,#e0b0ff);transition:width .3s}

.cat-section{margin-bottom:16px}
.cat-title{font-size:12px;font-weight:700;letter-spacing:.4px;margin-bottom:6px;padding-left:2px}
.cat-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(72px,1fr));gap:6px}
.cat-item{background:var(--panel);border-radius:8px;padding:6px 4px;text-align:center;border:1px solid var(--border);position:relative;opacity:.85}
.cat-item.owned{opacity:1}
.cat-item .cat-icon{display:flex;justify-content:center}
.cat-item .cat-icon svg{width:28px;height:28px}
.cat-item .cat-name{font-size:9px;line-height:1.1;margin-top:2px;color:#cfcfe0;height:20px;overflow:hidden}
.cat-item .cat-count{font-size:9px;font-weight:700;color:var(--accent);margin-top:2px}
.cat-item.locked{filter:grayscale(.8);opacity:.4}

#nav{position:fixed;bottom:0;left:0;right:0;height:calc(var(--nav-h) + env(safe-area-inset-bottom));padding-bottom:env(safe-area-inset-bottom);background:linear-gradient(180deg,#16162a,#0a0a12);border-top:1px solid var(--border);display:flex;justify-content:space-around;align-items:center;z-index:20}
#nav button{flex:1;height:var(--nav-h);color:var(--muted);font-size:10px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;transition:color .15s;position:relative}
#nav button .nav-icon{width:22px;height:22px;transition:transform .2s}
#nav button.active{color:var(--accent)}
#nav button.active .nav-icon{transform:scale(1.15)}
#nav button .nav-badge{position:absolute;top:6px;right:50%;margin-right:-22px;background:#e91e63;color:#fff;font-size:9px;font-weight:800;padding:1px 5px;border-radius:8px}

#overlay{position:fixed;inset:0;z-index:100;background:radial-gradient(ellipse at center,rgba(20,20,40,.98),rgba(5,5,12,.99));display:flex;flex-direction:column;align-items:center;justify-content:center;padding:16px;gap:16px}
#overlay.hidden{display:none}
.case-title{font-size:15px;font-weight:700;letter-spacing:.5px}
.roulette-wrap{width:100%;max-width:760px;height:150px;background:linear-gradient(180deg,#16162a,#0d0d1a);border-radius:12px;position:relative;overflow:hidden;border:1px solid var(--border);box-shadow:inset 0 0 40px rgba(0,0,0,.6)}
.roulette-track{display:flex;gap:8px;position:absolute;top:15px;left:0;will-change:transform}
.rou-item{width:110px;height:120px;flex-shrink:0;background:linear-gradient(180deg,#22223a,#16162a);border-radius:10px;border:2px solid #333;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;padding:6px;text-align:center;overflow:hidden;position:relative}
.rou-item .ri-icon{width:38px;height:38px}
.rou-item .ri-icon svg{width:100%;height:100%}
.rou-item .ri-name{font-size:10px;line-height:1.1;font-weight:600;color:#e0e0f0;height:22px;overflow:hidden}
.rou-item .ri-val{font-size:11px;color:var(--gold);font-weight:700}
.rou-item .ri-rar{font-size:9px;font-weight:800;letter-spacing:.4px}
.marker{position:absolute;top:0;bottom:0;left:50%;width:2px;background:linear-gradient(180deg,transparent,#ffd700,transparent);transform:translateX(-50%);z-index:5;pointer-events:none}
.marker:before,.marker:after{content:"";position:absolute;left:50%;transform:translateX(-50%);border-left:7px solid transparent;border-right:7px solid transparent}
.marker:before{top:-2px;border-top:10px solid #ffd700}
.marker:after{bottom:-2px;border-bottom:10px solid #ffd700}
.result-card{min-width:220px;max-width:90vw;padding:18px 22px;border-radius:14px;background:var(--panel);text-align:center;border:2px solid #333;animation:pop .4s cubic-bezier(.2,1.5,.5,1);display:flex;flex-direction:column;align-items:center;gap:6px}
@keyframes pop{0%{transform:scale(.4);opacity:0}100%{transform:scale(1);opacity:1}}
.result-card .rc-icon{width:70px;height:70px}
.result-card .rc-icon svg{width:100%;height:100%}
.result-card .rc-name{font-size:17px;font-weight:800}
.result-card .rc-rar{font-size:12px;font-weight:700;letter-spacing:.5px}
.result-card .rc-val{font-size:16px;color:var(--gold);font-weight:800}
.overlay-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:center}
.overlay-actions button{padding:11px 18px;border-radius:10px;background:var(--panel2);color:var(--text);font-size:13px;font-weight:700;transition:filter .12s}
.overlay-actions button.primary{background:linear-gradient(135deg,#00d4ff,#0080ff);color:#001}
.overlay-actions button:active{filter:brightness(.85)}

#sheet{position:fixed;inset:0;z-index:200;background:rgba(0,0,0,.7);display:flex;align-items:flex-end;justify-content:center}
#sheet.hidden{display:none}
.sheet-inner{width:100%;max-width:520px;background:var(--panel);border-radius:18px 18px 0 0;padding:18px 16px calc(18px + env(safe-area-inset-bottom));animation:slideUp .25s ease-out}
@keyframes slideUp{from{transform:translateY(100%)}to{transform:translateY(0)}}
.sheet-head{display:flex;align-items:center;gap:12px;margin-bottom:10px}
.sheet-head svg{width:52px;height:52px;flex-shrink:0}
.sheet-head .sheet-title{font-size:16px;font-weight:700}
.sheet-head .sheet-sub{font-size:12px;color:var(--muted);margin-top:3px}

#promo{position:fixed;inset:0;z-index:250;background:rgba(0,0,0,.8);display:flex;align-items:center;justify-content:center;padding:20px}
#promo.hidden{display:none}
.promo-inner{background:var(--panel);border-radius:16px;padding:22px;width:100%;max-width:340px;text-align:center;border:1px solid #3a3a5a;animation:pop .3s;box-shadow:0 20px 60px rgba(0,0,0,.6)}
.promo-inner h3{font-size:18px;margin-bottom:6px}
.promo-inner input{width:100%;padding:12px 14px;border-radius:10px;border:1.5px solid #3a3a5a;background:#0e0e1a;color:#fff;font-size:16px;font-weight:700;letter-spacing:3px;text-align:center;margin:14px 0;text-transform:uppercase;font-family:'SF Mono',Menlo,Consolas,monospace;outline:none;transition:border-color .15s,box-shadow .15s}
.promo-inner input:focus{border-color:var(--accent);box-shadow:0 0 14px rgba(0,212,255,.4)}

#toast-wrap{position:fixed;top:calc(env(safe-area-inset-top) + 70px);left:50%;transform:translateX(-50%);z-index:500;display:flex;flex-direction:column;gap:6px;pointer-events:none;width:max-content;max-width:90vw}
.toast{background:rgba(30,30,55,.96);color:#fff;padding:9px 16px;border-radius:20px;font-size:12.5px;font-weight:600;border:1px solid #3a3a5a;animation:toastIn .25s ease-out;box-shadow:0 6px 20px rgba(0,0,0,.4)}
@keyframes toastIn{from{opacity:0;transform:translateY(-10px)}to{opacity:1;transform:translateY(0)}}

.particle{position:fixed;width:7px;height:7px;border-radius:50%;pointer-events:none;z-index:300;animation:pf 1.1s ease-out forwards}
@keyframes pf{0%{transform:translate(0,0) scale(1);opacity:1}100%{transform:translate(var(--dx),var(--dy)) scale(0);opacity:0}}

@keyframes shake{0%,100%{transform:translate(0,0)}20%{transform:translate(-6px,4px)}40%{transform:translate(5px,-5px)}60%{transform:translate(-4px,-3px)}80%{transform:translate(4px,5px)}}
.shake{animation:shake .5s}

.empty{text-align:center;color:var(--muted);font-size:13px;padding:40px 20px;line-height:1.5}
</style>
</head>
<body>

<header id="hud">
  <div class="hud-l">
    <div class="avatar" id="avatarEl"></div>
    <div class="lvl">Уровень<br><b id="lvlVal">1</b></div>
  </div>
  <div class="hud-center">
    <div class="coin-box">
      <span id="coinIcon"></span>
      <span class="coin-val" id="coinVal">0</span>
    </div>
    <div class="luck-pill" data-action="open-luck" id="luckPill">
      <span id="luckIcon"></span>
      <span id="luckVal">×1.00</span>
    </div>
  </div>
  <div class="hud-r">
    <button class="icon-btn" data-action="open-promo" id="giftBtn"></button>
    <button class="icon-btn" data-action="toggle-sound" id="soundBtn"></button>
  </div>
</header>

<main id="view"></main>

<nav id="nav"></nav>

<div id="overlay" class="hidden">
  <div class="case-title" id="overlayTitle">Открытие кейса</div>
  <div class="roulette-wrap">
    <div class="marker"></div>
    <div class="roulette-track" id="rouTrack"></div>
  </div>
  <div id="resultSlot"></div>
  <div class="overlay-actions" id="overlayActions">
    <button data-action="close-overlay">Закрыть</button>
  </div>
</div>

<div id="sheet" class="hidden"><div class="sheet-inner" id="sheetInner"></div></div>

<div id="promo" class="hidden">
  <div class="promo-inner">
    <h3>Промокод</h3>
    <p class="sub" style="margin:6px 0 0">Введи код и получи награду</p>
    <input type="text" id="promoInput" placeholder="КОД" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="20">
    <button class="btn gold" data-action="submit-promo">Активировать</button>
    <button class="btn" data-action="close-promo">Отмена</button>
  </div>
</div>

<div id="toast-wrap"></div>

<script>
'use strict';

/* ============================================================
   SAFE STORAGE (работает даже в песочнице без localStorage)
   ============================================================ */
const SafeStorage = (() => {
  let mem = Object.create(null);
  let ok = false;
  try {
    const t = '__cr_test__' + Math.random();
    window.localStorage.setItem(t, '1');
    window.localStorage.removeItem(t);
    ok = true;
  } catch(e) { ok = false; }
  return {
    getItem(k){
      if(ok){ try { return window.localStorage.getItem(k); } catch(e){} }
      return Object.prototype.hasOwnProperty.call(mem, k) ? mem[k] : null;
    },
    setItem(k, v){
      if(ok){ try { window.localStorage.setItem(k, v); return; } catch(e){} }
      mem[k] = String(v);
    },
    removeItem(k){
      if(ok){ try { window.localStorage.removeItem(k); return; } catch(e){} }
      delete mem[k];
    }
  };
})();

/* ============================================================
   SVG TEXTURES
   ============================================================ */
let _uid = 0;
const _g = () => 'g' + (++_uid) + Math.floor(Math.random()*1000);

const SVG = {
  avatar(s=36){
    const id = _g();
    return `<svg width="${s}" height="${s}" viewBox="0 0 40 40">
      <defs><linearGradient id="${id}" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#00d4ff"/><stop offset="1" stop-color="#9c27b0"/>
      </linearGradient></defs>
      <circle cx="20" cy="20" r="20" fill="url(#${id})"/>
      <circle cx="20" cy="15" r="6" fill="#fff" opacity="0.9"/>
      <path d="M6 37 Q6 26 20 26 Q34 26 34 37 Z" fill="#fff" opacity="0.9"/>
    </svg>`;
  },
  coin(s=18){
    const id = _g();
    return `<svg width="${s}" height="${s}" viewBox="0 0 32 32" fill="none">
      <defs><radialGradient id="${id}" cx="30%" cy="30%" r="70%">
        <stop offset="0" stop-color="#fff8b0"/>
        <stop offset="0.5" stop-color="#ffd700"/>
        <stop offset="1" stop-color="#b8860b"/>
